# Data is never committed. Acquisition is scripted and checksummed instead;
# see docs/03-data-sources.md and data/MANIFEST.tsv.
data/
!data/MANIFEST.tsv
!data/.gitkeep

# Generated figures. The PNGs are the project's deliverables and are committed;
# the SVG sources are not. Written as figures/* rather than figures/, because
# git does not descend into an excluded directory and the negations below would
# never be read.
figures/*
!figures/.gitkeep
!figures/*.png

# Environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Large intermediates that occasionally escape data/
*.h5ad
*.bed
*.bim
*.fam
*.vcf
*.vcf.gz

# Editor and OS
.DS_Store
.vscode/
.idea/
.review_tmp/

# Local-only working material
docs/
presentation/
